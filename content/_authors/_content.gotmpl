{{- /*
  Seed every author that appears in content (or site.Params.author / data/authors)
  as an `authors` taxonomy term, so /authors/<name>/ exists even when the page
  only uses legacy `author: "X"` or falls back to the site default author.

  Terms are added as `kind: term` pages (not a stub regular page), so they never
  occupy a content section and never disturb site.MainSections auto-detection.
  Combined with function/pages-by-author.html, each archive lists every page
  that resolves to that author. Controlled by `params.author_archive` — keep it
  in sync with `author = "authors"` in `[taxonomies]`.
*/ -}}
{{- $adapter := . -}}
{{- if not (site.Params.author_archive | default true) -}}
  {{- return -}}
{{- end -}}
{{- $names := slice -}}
{{- with site.Params.author.name -}}
  {{- $names = $names | append . -}}
{{- else -}}
  {{- $names = $names | append "Anonymous" -}}
{{- end -}}
{{- $names = union $names (partial "function/scan-author-names.html" "content") -}}
{{- range $key, $entry := (hugo.Data.authors | default dict) -}}
  {{- $names = $names | append $key -}}
  {{- with $entry.name -}}
    {{- $names = $names | append . -}}
  {{- end -}}
{{- end -}}
{{- $seen := dict -}}
{{- range $names -}}
  {{- $v := strings.TrimSpace (printf "%v" .) -}}
  {{- if and $v (ne $v "null") (ne $v "~") (not (hasPrefix $v "-")) (not (in $v ":")) -}}
    {{- /* urlize percent-encodes non-ASCII; decode before using as a filesystem path. */ -}}
    {{- $slug := $v | urlize | urls.PathUnescape -}}
    {{- if not (index $seen $slug) -}}
      {{- $seen = merge $seen (dict $slug true) -}}
      {{- if not (fileExists (printf "content/authors/%s/_index.md" $slug)) -}}
        {{- $r := try ($adapter.AddPage (dict
          "kind" "term"
          "path" (printf "../authors/%s" $slug)
          "title" $v
          "content" (dict "mediaType" "text/markdown" "value" "")
        )) -}}
        {{- with $r.Err -}}
          {{- warnf "FixIt: skip author term %q: %v" $v . -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
